# URL do gt-backend
VITE_API_BASE_URL=http://localhost:3000

# Opcional: JWT emitido por POST /auth/login ou /auth/register, para trabalhar
# localmente sem passar pela tela de login. Não tem refresh token, então a
# sessão não rotaciona — e não substitui identidade: o ator sai do JWT que o
# servidor verifica.
VITE_DEV_ACCESS_TOKEN=

# Credenciais de uma conta semeada no backend, usadas só pelos testes e2e.
# Sem elas, os specs que exigem sessão são pulados.
E2E_EMAIL=
E2E_PASSWORD=
E2E_BACKOFFICE_EMAIL=
E2E_BACKOFFICE_PASSWORD=
